{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UsagePin",
  "version": "0.1.0",
  "identifier": "com.usagepin.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UsagePin",
        "width": 320,
        "height": 140,
        "minWidth": 1,
        "minHeight": 1,
        "visible": false,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "noRedirectionBitmap": true
      },
      {
        "label": "settings",
        "title": "UsagePin Settings",
        "url": "index.html?window=settings",
        "width": 600,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
